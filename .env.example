# Local Postgres connection (see compose.yml — `docker compose up -d`)
DATABASE_HOST=localhost
DATABASE_USERNAME=my_linktree
DATABASE_PASSWORD=my_linktree

# Set to console-friendly email delivery automatically in development (Rails' :test
# delivery method); set MAILER_RESEND_API_KEY and deploy with RAILS_ENV=production
# to send real email through Resend.
MAILER_SENDER_EMAIL=dev@example.com
MAILER_RECIPIENT_EMAIL=
MAILER_RESEND_API_KEY=
