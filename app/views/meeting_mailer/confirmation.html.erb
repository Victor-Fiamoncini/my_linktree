<% c = MailerHelper::FRAPPE %>
<% content_for :preheader, "Your meeting is confirmed for #{@slot_start}." %>

<%= mail_prompt "$ meet --confirmed", :green %>
<%= mail_heading "Meeting confirmed" %>

<p style="margin:0 0 20px;">Hi <%= @name %>,</p>
<p style="margin:0 0 20px;">Your meeting with Victor Fiamoncini is confirmed for</p>

<%# A terminal panel, like the page's %>
<%= mail_px_box fill: c[:term_bg], line: c[:line], drop: c[:drop], full_width: true, cell_style: "padding:16px 20px;font-family:#{MailerHelper::FONT_MONO};font-size:15px;font-weight:700;line-height:1.6;color:#{c[:term_green]};" do %><%= @slot_start %><% end %>

<p style="margin:24px 0 0;">Looking forward to talking. See you then!</p>

<%= mail_button "Visit #{URI(SeoConfig::SITE_URL).host}", SeoConfig::SITE_URL %>
