<% c = MailerHelper::FRAPPE %>
<% content_for :preheader, "Your meeting is confirmed for #{@slot_start}." %>

<%= mail_heading "Meeting confirmed" %>

<p style="margin:0 0 20px;">Hi <%= @name %>,</p>
<p style="margin:0 0 20px;">Your meeting with Victor Fiamoncini is confirmed for</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:16px 20px;background-color:<%= c[:surface0] %>;border-left:3px solid <%= c[:green] %>;font-family:<%= MailerHelper::FONT_MONO %>;font-size:14px;line-height:1.6;color:<%= c[:green] %>;"><%= @slot_start %></td>
  </tr>
</table>

<p style="margin:20px 0 0;">Looking forward to talking. See you then!</p>

<%= mail_button "Visit #{URI(SeoConfig::SITE_URL).host}", SeoConfig::SITE_URL %>
