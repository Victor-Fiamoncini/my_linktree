<!DOCTYPE html>
<% c = MailerHelper::FRAPPE %>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="supported-color-schemes" content="dark">
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&family=JetBrains+Mono:wght@400;700&family=Pixelify+Sans:wght@400..700&display=swap" rel="stylesheet">
    <title><%= message.subject %></title>
  </head>

  <body style="margin:0;padding:0;background-color:<%= c[:base] %>;">
    <% if content_for?(:preheader) %>
      <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:<%= c[:base] %>;"><%= yield :preheader %></div>
    <% end %>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= c[:base] %>;">
      <tr>
        <td align="center" style="padding:32px 16px 40px;">
          <%# The page's px-panel: mantle on base, outlined in line, crust drop shadow, surface0 bevel on top %>
          <%= mail_px_box fill: c[:mantle], line: c[:line], drop: c[:drop], full_width: true, table_style: "max-width:608px;", cell_style: "border-top:4px solid #{c[:surface0]};" do %>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="padding:16px 28px;border-bottom:4px solid <%= c[:line] %>;">
                  <a href="<%= SeoConfig::SITE_URL %>" style="text-decoration:none;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="vertical-align:middle;">
                          <%= mail_px_box fill: c[:mauve], line: c[:ink], drop: c[:ink], unit: 2 do %>
                            <img src="<%= SeoConfig::SITE_URL %>/icon.png" alt="" width="36" height="36" style="display:block;width:36px;height:36px;">
                          <% end %>
                        </td>
                        <td style="padding-left:14px;vertical-align:middle;<%= MailerHelper::PIXEL_TYPE %>font-size:20px;font-weight:600;color:<%= c[:text] %>;"><%= SeoConfig::AUTHOR_NAME %></td>
                      </tr>
                    </table>
                  </a>
                </td>
              </tr>

              <tr>
                <td style="padding:32px 28px;background-color:<%= c[:base] %>;font-family:<%= MailerHelper::FONT_SANS %>;font-size:16px;line-height:1.7;color:<%= c[:subtext1] %>;">
                  <%= yield %>
                </td>
              </tr>

              <tr>
                <td style="padding:16px 28px;border-top:4px solid <%= c[:line] %>;<%= MailerHelper::PIXEL_TYPE %>font-size:14px;line-height:1.8;color:<%= c[:overlay1] %>;">
                  <a href="<%= SeoConfig::SITE_URL %>" style="color:<%= c[:blue] %>;text-decoration:none;"><%= URI(SeoConfig::SITE_URL).host %></a>
                  &nbsp;·&nbsp;
                  <a href="<%= SeoConfig::GITHUB_URL %>" style="color:<%= c[:blue] %>;text-decoration:none;">GitHub</a>
                  &nbsp;·&nbsp;
                  <a href="<%= SeoConfig::LINKEDIN_URL %>" style="color:<%= c[:blue] %>;text-decoration:none;">LinkedIn</a>
                </td>
              </tr>
            </table>
          <% end %>
        </td>
      </tr>
    </table>
  </body>
</html>
