<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || default_title %></title>
    <meta name="description" content="<%= content_for(:description) || default_description %>">
    <meta name="author" content="Victor Fiamoncini">
    <meta name="robots" content="<%= content_for(:robots) || "index, follow, max-image-preview:large" %>">
    <link rel="canonical" href="<%= SeoConfig::SITE_URL %><%= canonical_path %>">
    <% I18n.available_locales.each do |locale| %>
      <link rel="alternate" hreflang="<%= locale %>" href="<%= SeoConfig::SITE_URL %><%= canonical_path.sub(%r{\A/(en|pt-BR)}, "/#{locale}") %>">
    <% end %>
    <link rel="alternate" hreflang="x-default" href="<%= SeoConfig::SITE_URL %><%= canonical_path.sub(%r{\A/(en|pt-BR)}, "/en") %>">

    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="#8caaee">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="msapplication-navbutton-color" content="#8caaee">
    <meta name="apple-mobile-web-app-status-bar-style" content="#8caaee">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Victor Fiamoncini">

    <meta property="og:type" content="website">
    <meta property="og:locale" content="<%= I18n.locale == :"pt-BR" ? "pt_BR" : "en_US" %>">
    <meta property="og:site_name" content="Victor Fiamoncini">
    <meta property="og:url" content="<%= SeoConfig::SITE_URL %><%= canonical_path %>">
    <meta property="og:title" content="<%= content_for(:og_title) || content_for(:title) || default_title %>">
    <meta property="og:description" content="<%= content_for(:description) || default_description %>">
    <meta property="og:image" content="<%= SeoConfig::SITE_URL %>/opengraph-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Victor Fiamoncini">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:og_title) || content_for(:title) || default_title %>">
    <meta name="twitter:description" content="<%= content_for(:description) || default_description %>">
    <meta name="twitter:image" content="<%= SeoConfig::SITE_URL %>/opengraph-image.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="/site.webmanifest">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=JetBrains+Mono:wght@400..700&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= render "shared/person_json_ld" %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="bg-ctp-base flex min-h-screen flex-col font-sans antialiased" data-controller="cursor-trail">
    <%= render "shared/header" %>

    <%= yield %>

    <%= render "shared/footer" %>
  </body>
</html>
