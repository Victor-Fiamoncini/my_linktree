<% content_for :title, t("errors.not_found.title") %>
<% content_for :og_title, t("errors.not_found.og_title") %>
<% content_for :description, t("errors.not_found.description") %>
<% content_for :canonical, @localized_path %>
<% content_for :robots, "noindex, nofollow" %>

<main class="flex flex-1 flex-col items-center overflow-x-clip px-5 min-[640px]:px-8 py-16">
  <section class="w-full max-w-[1080px]">
    <%= render "shared/section_heading", tag_name: :h1, prompt: "$ cd #{@localized_path}", heading: t("errors.not_found.heading"), prompt_class: "bg-ctp-pink text-on-accent" %>

    <p class="text-ctp-subtext1 mb-9 max-w-[68ch] text-lg leading-[1.7] text-pretty"><%= t("errors.not_found.body") %></p>

    <div class="bg-term-bg px-panel m-1 mb-10 [--px-drop:var(--color-ctp-red)] [--px-step:6px]">
      <div class="bg-term-bar flex items-center gap-3 px-4 py-2.5 shadow-[0_4px_0_0_var(--color-line)]">
        <span class="text-term-text font-mono text-[13px] font-bold">zsh</span>
      </div>

      <div class="px-5 py-4 font-mono text-sm font-bold">
        <p class="text-term-red"><%= t("errors.not_found.shell_error") %></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-6 p-1 font-pixel text-lg">
      <%= link_to t("errors.not_found.home_label"), root_path, title: t("errors.not_found.home_title"), class: "bg-ctp-blue text-on-strong hover:text-on-strong px-raised press inline-flex min-h-[52px] items-center px-[26px]" %>
      <%= link_to t("errors.not_found.telemetry_label"), telemetry_path, title: t("errors.not_found.telemetry_title"), class: "bg-ctp-mantle text-ctp-text hover:text-ctp-text px-frame press inline-flex min-h-[52px] items-center px-[22px]" %>
    </div>
  </section>
</main>
