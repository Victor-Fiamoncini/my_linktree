<section id="contact" class="border-ctp-surface0 w-full max-w-[1080px] border-t pt-14 pb-14">
  <p class="text-ctp-teal mb-3.5 font-mono text-[13px] tracking-[0.06em]">$ echo "let's talk"</p>

  <h2 class="text-ctp-text mb-4 text-[28px] font-semibold tracking-[-0.025em] min-[900px]:text-[34px]">Reach out</h2>

  <p class="text-ctp-subtext0 mb-10 w-full text-[17px] leading-[1.7] text-pretty text-justify">
    Working on something interesting? I'm always open to remote roles, freelance work, and fullstack collaboration
		from frontend and backend development to agentic systems, landing pages, and mobile apps. Drop a few details
    below if you have a project in mind, and I'll get back to you ASAP. Let's talk!
  </p>

  <div class="grid gap-12 min-[900px]:grid-cols-[1.2fr_1fr] min-[900px]:items-start">
    <%= render "pages/contact_form" %>
    <%= render "pages/contact_aside" %>
  </div>
</section>
