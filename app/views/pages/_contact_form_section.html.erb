<section id="contact" class="w-full max-w-[1080px] pt-14 pb-24">
  <%= render "shared/section_heading", prompt: t("pages.contact_form_section.prompt"), heading: t("pages.contact_form_section.heading"), prompt_class: "bg-ctp-pink text-on-accent", counter: "04/04" %>

  <p class="text-ctp-subtext1 mb-10 max-w-[68ch] text-lg leading-[1.7] text-pretty">
    <%= t("pages.contact_form_section.intro") %>
  </p>

  <div class="grid grid-cols-1 gap-10 min-[900px]:grid-cols-[1.3fr_1fr] min-[900px]:items-start">
    <%= render "pages/contact_form" %>
    <%= render "pages/contact_aside" %>
  </div>
</section>
