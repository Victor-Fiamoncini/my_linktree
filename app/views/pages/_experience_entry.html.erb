<article>
  <h3 class="text-ctp-text mb-2 text-2xl leading-tight font-bold"><%= experience[:role] %></h3>

  <% if experience[:start_date].present? %>
    <p class="text-ctp-subtext0 mb-1 font-mono text-sm">
      <%= format_experience_date(experience[:start_date]) %> — <%= format_experience_date(experience[:end_date]) %>
      <span class="block whitespace-nowrap min-[640px]:ml-2 min-[640px]:inline">(<%= experience_duration(experience[:start_date], experience[:end_date]) %>)</span>
    </p>
  <% end %>

  <p class="text-ctp-subtext0 mb-[22px] font-mono text-sm">
    <%= experience[:location] %>
  </p>

  <% if experience[:description].present? %>
    <p class="text-ctp-text mb-7 text-[17px] leading-[1.7] text-pretty hyphens-auto min-[640px]:text-justify"><%= experience[:description] %></p>
  <% end %>

  <div class="flex flex-col gap-4">
    <% ExperiencesHelper::TECH_CATEGORIES.each do |category| %>
      <% items = experience[category[:key]] %>
      <% if items.present? %>
        <div class="flex flex-wrap items-center gap-2.5">
          <p class="mr-1 min-w-[84px] px-2 py-[3px] text-center font-pixel text-sm <%= category[:accent_class] %>"><%= t(category[:label_key]) %></p>
          <% items.each do |tech| %>
            <span class="bg-ctp-base text-ctp-text px-frame-sm m-0.5 px-[9px] py-[3px] font-mono text-[13px] font-bold [--px-line:var(--color-ctp-surface1)]"><%= tech %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</article>
