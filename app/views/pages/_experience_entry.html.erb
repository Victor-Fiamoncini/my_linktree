<div>
  <div class="mb-1.5 flex flex-wrap items-baseline gap-2.5">
    <h3 class="text-ctp-text text-[23px] font-semibold"><%= experience[:role] %></h3>
    <span class="text-ctp-mauve text-[19px] font-medium">@ <%= experience[:company] %></span>
  </div>

  <p class="text-ctp-subtext0 mb-1 font-mono text-[13px]">
    <%= format_experience_date(experience[:start_date]) %> — <%= format_experience_date(experience[:end_date]) %>
    <span class="text-ctp-overlay0 ml-2">(<%= experience_duration(experience[:start_date], experience[:end_date]) %>)</span>
  </p>

  <p class="text-ctp-overlay0 mb-[22px] flex items-center gap-2 font-mono text-[13px]">
    <span><%= experience[:location] %></span>
    <% if experience[:country_flag].present? %><span title="<%= experience[:country_name] %>"><%= experience[:country_flag] %></span><% end %>
  </p>

  <% if experience[:description].present? %>
    <p class="text-ctp-subtext1 mb-7 max-w-[62ch] text-base leading-[1.75] text-pretty"><%= experience[:description] %></p>
  <% end %>

  <div class="flex flex-col gap-[18px]">
    <% ExperiencesHelper::TECH_CATEGORIES.each do |category| %>
      <% items = experience[category[:key]] %>
      <% if items.present? %>
        <div>
          <p class="mb-2.5 font-mono text-[11px] font-medium tracking-[0.12em] uppercase <%= category[:accent_class] %>"><%= category[:label] %></p>
          <div class="flex flex-wrap gap-2">
            <% items.each do |tech| %>
              <span class="bg-ctp-base border-ctp-surface1 text-ctp-text rounded-chip border px-3 py-1.5 font-mono text-[13px]"><%= tech %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
