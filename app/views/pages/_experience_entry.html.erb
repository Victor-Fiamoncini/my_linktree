<article>
  <h3 class="text-ctp-text mb-2 text-2xl font-bold tracking-[-0.02em]"><%= experience[:role] %></h3>

  <p class="text-ctp-subtext0 mb-1 font-mono text-sm">
    <%= format_experience_date(experience[:start_date]) %> — <%= format_experience_date(experience[:end_date]) %>
    <span class="ml-2">(<%= experience_duration(experience[:start_date], experience[:end_date]) %>)</span>
  </p>

  <p class="text-ctp-subtext0 mb-[22px] font-mono text-sm">
    <%= experience[:location] %>
  </p>

  <% if experience[:description].present? %>
    <p class="text-ctp-text mb-7 text-[17px] leading-[1.7] text-pretty text-justify"><%= experience[:description] %></p>
  <% end %>

  <div class="flex flex-col gap-4">
    <% ExperiencesHelper::TECH_CATEGORIES.each do |category| %>
      <% items = experience[category[:key]] %>
      <% if items.present? %>
        <div class="flex flex-wrap items-center gap-2">
          <p class="border-ink mr-1 min-w-[92px] border-2 px-2.5 py-1 text-center font-mono text-xs font-extrabold tracking-[0.08em] uppercase <%= category[:accent_class] %>"><%= t(category[:label_key]) %></p>
          <% items.each do |tech| %>
            <span class="bg-ctp-base border-ink text-ctp-text border-2 px-2.5 py-1 font-mono text-[13px] font-semibold"><%= tech %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</article>
