<%
  agents_md_preview = <<~MARKDOWN
    #{t("pages.hire_from_agent.agents_md_title")}

    #{t("pages.hire_from_agent.agents_md_contact_line")}
    POST #{SeoConfig::SITE_URL}/api/hire
    Content-Type: application/json

    {
      "name": "Your name",
      "contact": "email or preferred channel",
      "brief": "What you want to discuss",
      "agent": "claude | chatgpt | deepseek | kimi | other"
    }

    #{t("pages.hire_from_agent.agents_md_services_line")}
  MARKDOWN
%>

<%
  terminal_class = "border-ink bg-term-bg shadow-brut-lg w-full border-4 text-left"
  terminal_bar_class = "border-ink bg-term-bar flex items-center justify-between gap-3 border-b-4 px-4 py-2.5"
  traffic_light_class = "border-ink h-3.5 w-3.5 shrink-0 border-2"
  copy_button_class = "bg-ctp-peach text-on-accent border-ink press min-h-9 shrink-0 cursor-pointer border-2 px-3.5 font-mono text-xs font-extrabold tracking-[0.08em] uppercase"
  tool_accents = %w[border-t-ctp-blue border-t-ctp-mauve border-t-ctp-green border-t-ctp-yellow border-t-ctp-peach]
%>

<section id="agents" class="w-full max-w-[1080px] py-14"
  data-controller="hire-from-agent"
  data-hire-from-agent-copy-label-value="<%= t("pages.hire_from_agent.copy") %>"
  data-hire-from-agent-copied-label-value="<%= t("pages.hire_from_agent.copied") %>">
  <%= render "shared/section_heading", prompt: t("pages.hire_from_agent.prompt"), heading: t("pages.hire_from_agent.heading"), prompt_class: "bg-ctp-peach text-on-accent", counter: "[02/04]" %>

  <%
    mcp_link = link_to("MCP", "https://modelcontextprotocol.io/", target: "_blank", rel: "noreferrer", title: t("pages.hire_from_agent.mcp_link_title"), class: "link-brut px-0.5 [--link-accent:var(--color-ctp-mauve)]")
    mcp_server = content_tag(:span, t("pages.hire_from_agent.mcp_server"), class: "text-ctp-text font-bold")
  %>
  <p class="text-ctp-subtext0 mb-9 w-full text-lg leading-[1.7] text-pretty min-[640px]:text-justify">
    <%= t("pages.hire_from_agent.intro_html", mcp_link: mcp_link, mcp_server: mcp_server) %>
  </p>

  <div class="<%= terminal_class %> shadow-ctp-peach mb-9">
    <div class="<%= terminal_bar_class %>">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="<%= traffic_light_class %> bg-term-red"></span>
          <span class="<%= traffic_light_class %> bg-term-yellow"></span>
          <span class="<%= traffic_light_class %> bg-term-green"></span>
        </span>
        <span class="text-term-text min-w-0 truncate font-mono text-[13px] font-extrabold tracking-[0.08em] max-[424px]:tracking-normal">MY_MCP_ENDPOINT.md</span>
      </div>

      <button
        type="button"
        title="<%= t("pages.hire_from_agent.copy_endpoint_title") %>"
        data-action="hire-from-agent#copy"
        data-hire-from-agent-content-param="<%= SeoConfig::MCP_ENDPOINT %>"
        class="<%= copy_button_class %>"
      ><%= t("pages.hire_from_agent.copy") %></button>
    </div>

    <pre class="text-term-green w-full overflow-x-auto px-5 py-[22px] font-mono text-[15px] leading-[1.8] font-bold"><code><%= SeoConfig::MCP_ENDPOINT %> <span class="text-ctp-subtext1"><%= t("pages.hire_from_agent.no_auth_note") %></span>
<span class="text-ctp-subtext1"><%= t("pages.hire_from_agent.watch_telemetry_note_html", url: "#{SeoConfig::SITE_URL}/#{I18n.locale}/telemetry") %></span></code></pre>
  </div>

  <ul class="mb-12 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-[18px]">
    <% Api::McpController::TOOLS.map(&:tool_name).each_with_index do |tool_name, index| %>
      <li class="bg-ctp-mantle border-ink shadow-brut-sm border-[3px] border-t-[12px] p-[18px] <%= tool_accents[index % tool_accents.size] %>">
        <span class="text-ctp-subtext0 font-mono text-xs font-extrabold"><%= t("pages.hire_from_agent.tool_label", number: format("%02d", index + 1)) %></span>
        <code class="text-ctp-text mt-2 mb-2.5 block font-mono text-sm font-extrabold [overflow-wrap:anywhere]"><%= tool_name %></code>
        <p class="text-ctp-subtext0 text-[15px] leading-normal"><%= t("pages.hire_from_agent.tools.#{tool_name}") %></p>
      </li>
    <% end %>
  </ul>

  <p class="text-ctp-subtext0 mb-9 w-full text-lg leading-[1.7] text-pretty min-[640px]:text-justify">
    <%= t("pages.hire_from_agent.follow_up") %>
  </p>

  <div class="<%= terminal_class %> shadow-ctp-mauve">
    <div class="<%= terminal_bar_class %>">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="<%= traffic_light_class %> bg-term-red"></span>
          <span class="<%= traffic_light_class %> bg-term-yellow"></span>
          <span class="<%= traffic_light_class %> bg-term-green"></span>
        </span>
        <span class="text-term-text min-w-0 truncate font-mono text-[13px] font-extrabold tracking-[0.08em] max-[424px]:tracking-normal">AGENTS.md</span>
      </div>

      <button
        type="button"
        title="<%= t("pages.hire_from_agent.copy_agents_md_title") %>"
        data-action="hire-from-agent#copy"
        data-hire-from-agent-content-param="<%= agents_md_preview %>"
        class="<%= copy_button_class %>"
      ><%= t("pages.hire_from_agent.copy") %></button>
    </div>

    <pre class="text-term-green w-full overflow-x-auto p-5 font-mono text-[13px] leading-relaxed font-bold"><code><span class="text-ctp-subtext1"><%= agents_md_preview.lines.first.chomp %></span>
<%= agents_md_preview.lines.drop(1).join %></code></pre>
  </div>
</section>
