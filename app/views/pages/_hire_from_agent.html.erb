<section id="agents" class="border-ctp-surface0 w-full max-w-[1080px] border-t pt-14 pb-14" data-controller="hire-from-agent" data-hire-from-agent-content-value="<%= AgentsContent::CONTENT %>">
  <p class="text-ctp-peach mb-3.5 font-mono text-[13px] tracking-[0.06em]">$ ./hire-me --no-human-required</p>

  <h2 class="text-ctp-text mb-4 text-[28px] font-semibold tracking-[-0.025em] min-[900px]:text-[34px]">Hire me from your agent</h2>

  <p class="text-ctp-subtext0 mb-8 w-full text-[17px] leading-[1.7] text-pretty text-justify">
		This portfolio speaks <a href="https://modelcontextprotocol.io/" target="_blank" rel="noreferrer" class="text-ctp-mauve hover:text-ctp-pink">MCP</a>! It exposes an <span class="text-ctp-text font-semibold">MCP server</span> alongside the site
    itself, with four tools. Point your agent at the endpoint below to read my
    resume, check my services and real-time availability, and book a meeting directly on my calendar. No forms,
    no human in the loop!
  </p>

  <div class="w-full text-left">
    <div class="border-ctp-surface0 rounded-t-btn flex items-center justify-between border border-b-0 bg-[#181825] px-4 py-2">
      <div class="flex items-center gap-3">
        <span class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#f38ba8]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#f9e2af]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#a6e3a1]"></span>
        </span>
        <span class="text-xs font-bold tracking-widest text-[#cdd6f4]">AGENTS.md</span>
      </div>

      <button
        type="button"
        title="Copy AGENTS.md"
        data-action="hire-from-agent#copy"
        data-hire-from-agent-target="button"
        class="cursor-pointer text-xs font-bold tracking-widest uppercase transition-colors text-[#89b4fa] hover:text-[#cdd6f4]"
      >Copy</button>
    </div>

    <pre class="border-ctp-surface0 rounded-b-btn w-full overflow-x-auto border bg-[#1e1e2e] p-4 text-xs leading-relaxed font-semibold text-[#a6e3a1]"><code><%= AgentsContent::CONTENT %></code></pre>
  </div>
</section>
