<%
  agents_md_preview = <<~MARKDOWN
    #{t("pages.hire_from_agent.agents_md_title")}

    #{t("pages.hire_from_agent.agents_md_contact_line")}
    POST #{SeoConfig::SITE_URL}/api/hire
    Content-Type: application/json

    {
      "name": "Your name",
      "contact": "email or preferred channel",
      "brief": "What you want to discuss",
      "agent": "claude | chatgpt | deepseek | kimi | other"
    }

    #{t("pages.hire_from_agent.agents_md_services_line")}
  MARKDOWN
%>

<section id="agents" class="border-ctp-surface0 w-full max-w-[1080px] border-t pt-14 pb-14"
  data-controller="hire-from-agent"
  data-hire-from-agent-copy-label-value="<%= t("pages.hire_from_agent.copy") %>"
  data-hire-from-agent-copied-label-value="<%= t("pages.hire_from_agent.copied") %>">
  <p class="text-ctp-peach mb-3.5 font-mono text-[13px] tracking-[0.06em]"><%= t("pages.hire_from_agent.prompt") %></p>

  <h2 class="text-ctp-text mb-4 text-[28px] font-semibold tracking-[-0.025em] min-[900px]:text-[34px]"><%= t("pages.hire_from_agent.heading") %></h2>

	<%
	  mcp_link = link_to("MCP", "https://modelcontextprotocol.io/", target: "_blank", rel: "noreferrer", title: t("pages.hire_from_agent.mcp_link_title"), class: "text-ctp-mauve hover:text-ctp-pink transition-colors")
	  mcp_server = content_tag(:span, t("pages.hire_from_agent.mcp_server"), class: "text-ctp-text font-semibold")
	%>
	<p class="text-ctp-subtext0 mb-8 w-full text-[17px] leading-[1.7] text-pretty text-justify">
		<%= t("pages.hire_from_agent.intro_html", mcp_link: mcp_link, mcp_server: mcp_server) %>
	</p>

	<div class="mt-6 w-full text-left mb-8">
		<div class="border-ctp-surface0 rounded-t-btn flex items-center justify-between border border-b-0 bg-[#181825] px-4 py-2">
			<div class="flex items-center gap-3">
        <span class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#f38ba8]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#f9e2af]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#a6e3a1]"></span>
        </span>
				<span class="text-xs font-bold tracking-widest text-[#cdd6f4]">MY_MCP_ENDPOINT.md</span>
			</div>

			<button
				type="button"
				title="<%= t("pages.hire_from_agent.copy_endpoint_title") %>"
				data-action="hire-from-agent#copy"
				data-hire-from-agent-content-param="<%= SeoConfig::MCP_ENDPOINT %>"
				class="cursor-pointer text-xs font-bold tracking-widest uppercase transition-colors text-[#89b4fa] hover:text-[#cdd6f4]"
			><%= t("pages.hire_from_agent.copy") %></button>
		</div>

		<pre class="border-ctp-surface0 rounded-b-btn w-full overflow-x-auto border bg-[#1e1e2e] p-4 text-xs leading-relaxed font-semibold text-[#a6e3a1]"><code><%= SeoConfig::MCP_ENDPOINT %> <span class="text-ctp-overlay0 font-mono text-xs"><%= t("pages.hire_from_agent.no_auth_note") %></span>
			<span class="text-ctp-overlay0 font-mono text-xs block"><%= t("pages.hire_from_agent.watch_telemetry_note_html", url: "#{SeoConfig::SITE_URL}/telemetry") %></span></code></pre>
	</div>

  <p class="text-ctp-subtext0 mb-8 w-full text-[17px] leading-[1.7] text-pretty text-justify">
		<%= t("pages.hire_from_agent.follow_up") %>
  </p>

  <div class="w-full text-left">
    <div class="border-ctp-surface0 rounded-t-btn flex items-center justify-between border border-b-0 bg-[#181825] px-4 py-2">
      <div class="flex items-center gap-3">
        <span class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#f38ba8]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#f9e2af]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#a6e3a1]"></span>
        </span>
        <span class="text-xs font-bold tracking-widest text-[#cdd6f4]">AGENTS.md</span>
      </div>

      <button
        type="button"
        title="<%= t("pages.hire_from_agent.copy_agents_md_title") %>"
        data-action="hire-from-agent#copy"
        data-hire-from-agent-content-param="<%= agents_md_preview %>"
        class="cursor-pointer text-xs font-bold tracking-widest uppercase transition-colors text-[#89b4fa] hover:text-[#cdd6f4]"
      ><%= t("pages.hire_from_agent.copy") %></button>
    </div>

    <pre class="border-ctp-surface0 rounded-b-btn w-full overflow-x-auto border bg-[#1e1e2e] p-4 text-xs leading-relaxed font-semibold text-[#a6e3a1]"><code><span class="text-ctp-overlay0 font-mono text-xs"><%= agents_md_preview.lines.first.chomp %></span>
<%= agents_md_preview.lines.drop(1).join %></code></pre>
  </div>
</section>
