<%
  agents_md_preview = <<~MARKDOWN
    #{t("pages.hire_from_agent.agents_md_title")}

    #{t("pages.hire_from_agent.agents_md_contact_line")}
    POST #{SeoConfig::SITE_URL}/api/hire
    Content-Type: application/json

    {
      "name": "Your name",
      "contact": "email or preferred channel",
      "brief": "What you want to discuss",
      "agent": "claude | chatgpt | deepseek | kimi | other"
    }

    #{t("pages.hire_from_agent.agents_md_services_line")}
  MARKDOWN
%>

<%
  terminal_class = "bg-term-bg px-panel m-1 w-full text-left [--px-drop:var(--color-px-shadow)]"
  terminal_bar_class = "bg-term-bar flex items-center justify-between gap-3 py-2 pr-2 pl-4 shadow-[0_4px_0_0_var(--color-line)]"
  # hire_from_agent_controller.js flashes these peach -> green on copy, so both keep bg-ctp-peach
  copy_button_class = "bg-ctp-peach text-on-accent px-raised-sm press min-h-9 shrink-0 cursor-pointer px-3.5 font-pixel text-sm"
  tool_names = Api::McpController::TOOLS.map(&:tool_name)
%>
<section id="agents" class="w-full max-w-[1080px] py-14"
  data-controller="hire-from-agent"
  data-hire-from-agent-copy-label-value="<%= t("pages.hire_from_agent.copy") %>"
  data-hire-from-agent-copied-label-value="<%= t("pages.hire_from_agent.copied") %>">
  <%= render "shared/section_heading", prompt: t("pages.hire_from_agent.prompt"), heading: t("pages.hire_from_agent.heading"), prompt_class: "bg-ctp-peach text-on-accent", counter: "02/04" %>

  <%
    mcp_link = link_to("MCP", "https://modelcontextprotocol.io/", target: "_blank", rel: "noreferrer", title: t("pages.hire_from_agent.mcp_link_title"), class: "link-px [--link-accent:var(--color-ctp-mauve)]")
    mcp_server = content_tag(:span, t("pages.hire_from_agent.mcp_server"), class: "text-ctp-text font-bold")
  %>
  <p class="text-ctp-subtext1 mb-9 text-lg leading-[1.7] text-pretty hyphens-auto min-[640px]:text-justify">
    <%= t("pages.hire_from_agent.intro_html", mcp_link: mcp_link, mcp_server: mcp_server) %>
  </p>

  <div class="<%= terminal_class %> mb-10">
    <div class="<%= terminal_bar_class %>">
      <span class="text-term-text min-w-0 truncate font-mono text-[13px] font-bold">MY_MCP_ENDPOINT.md</span>

      <button
        type="button"
        title="<%= t("pages.hire_from_agent.copy_endpoint_title") %>"
        data-action="hire-from-agent#copy"
        data-hire-from-agent-content-param="<%= SeoConfig::MCP_ENDPOINT %>"
        class="<%= copy_button_class %>"
      ><%= t("pages.hire_from_agent.copy") %></button>
    </div>

    <pre class="text-term-green w-full overflow-x-auto px-5 pt-6 pb-5 font-mono text-[15px] leading-[1.8] font-bold"><code><%= SeoConfig::MCP_ENDPOINT %> <span class="text-ctp-subtext1"><%= t("pages.hire_from_agent.no_auth_note") %></span>
<span class="text-ctp-subtext1"><%= t("pages.hire_from_agent.watch_telemetry_note_html", url: "#{SeoConfig::SITE_URL}/#{I18n.locale}/telemetry") %></span></code></pre>
  </div>

  <div class="bg-ctp-mantle px-panel m-1 mb-12 flex flex-wrap" data-controller="tabs">
    <div role="tablist" aria-orientation="vertical" aria-label="<%= t("pages.hire_from_agent.tools_label") %>" class="bg-ctp-crust flex flex-[1_1_260px] flex-col gap-1 p-3.5">
      <% tool_names.each_with_index do |tool_name, index| %>
        <button
          type="button"
          role="tab"
          id="tool-tab-<%= tool_name %>"
          aria-controls="tool-panel-<%= tool_name %>"
          title="<%= t("pages.hire_from_agent.tool_tab_title", tool: tool_name) %>"
          aria-selected="<%= index.zero? %>"
          tabindex="<%= index.zero? ? 0 : -1 %>"
          data-tabs-target="tab"
          data-tabs-key="<%= tool_name %>"
          data-action="tabs#select keydown->tabs#navigate"
          class="group text-ctp-text aria-selected:bg-ctp-surface0 flex min-h-12 w-full cursor-pointer items-center gap-3 px-3 text-left transition-colors"
        >
          <span aria-hidden="true" class="text-ctp-peach block h-[11px] w-1.5 shrink-0 opacity-0 group-aria-selected:opacity-100"><%= svg_icon(:cursor) %></span>
          <span class="text-ctp-subtext0 group-aria-selected:text-ctp-peach font-pixel text-[13px]"><%= format("%02d", index + 1) %></span>
          <code class="min-w-0 font-mono text-[15px] font-bold [overflow-wrap:anywhere]"><%= tool_name %></code>
        </button>
      <% end %>
    </div>

    <% tool_names.each_with_index do |tool_name, index| %>
      <div
        role="tabpanel"
        id="tool-panel-<%= tool_name %>"
        aria-labelledby="tool-tab-<%= tool_name %>"
        data-tabs-target="panel"
        data-tabs-key="<%= tool_name %>"
        class="flex min-w-0 flex-[999_1_360px] flex-col gap-3.5 px-5 py-[26px] min-[640px]:px-[30px] <%= "hidden" unless index.zero? %>"
      >
        <span class="text-ctp-peach font-pixel text-sm"><%= t("pages.hire_from_agent.tool_label", number: format("%02d", index + 1)) %></span>
        <code class="text-ctp-text font-mono text-xl font-bold [overflow-wrap:anywhere]"><%= tool_name %></code>
        <p class="text-ctp-text text-lg leading-[1.6]"><%= t("pages.hire_from_agent.tools.#{tool_name}") %></p>

        <%# The same JSON-RPC body as to_json would give, pretty-printed and colored like the terminals above %>
        <div class="bg-term-bg px-frame-sm mt-2 [--px-line:var(--color-line)]">
          <div class="bg-term-bar flex items-center gap-2.5 px-4 py-2 font-mono text-[13px] font-bold shadow-[0_2px_0_0_var(--color-line)]">
            <span class="text-term-yellow">POST</span>
            <span class="text-term-text min-w-0 truncate">/api/mcp</span>
          </div>
          <pre class="text-ctp-subtext1 overflow-x-auto px-4 pt-4 pb-3.5 font-mono text-[13px] leading-[1.7]"><code>{
  <span class="text-term-blue">"method"</span>: <span class="text-term-green">"tools/call"</span>,
  <span class="text-term-blue">"params"</span>: {
    <span class="text-term-blue">"name"</span>: <span class="text-term-green">"<%= tool_name %>"</span>
  }
}</code></pre>
        </div>
      </div>
    <% end %>
  </div>

  <p class="text-ctp-subtext1 mb-9 text-lg leading-[1.7] text-pretty hyphens-auto min-[640px]:text-justify">
    <%= t("pages.hire_from_agent.follow_up") %>
  </p>

  <div class="<%= terminal_class %>">
    <div class="<%= terminal_bar_class %>">
      <span class="text-term-text min-w-0 truncate font-mono text-[13px] font-bold">AGENTS.md</span>

      <button
        type="button"
        title="<%= t("pages.hire_from_agent.copy_agents_md_title") %>"
        data-action="hire-from-agent#copy"
        data-hire-from-agent-content-param="<%= agents_md_preview %>"
        class="<%= copy_button_class %>"
      ><%= t("pages.hire_from_agent.copy") %></button>
    </div>

    <pre class="text-term-green w-full overflow-x-auto p-5 font-mono text-[13px] leading-relaxed font-bold"><code><span class="text-ctp-subtext1"><%= agents_md_preview.lines.first.chomp %></span>
<%= agents_md_preview.lines.drop(1).join %></code></pre>
  </div>
</section>
