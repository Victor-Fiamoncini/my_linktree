<%
  agents_md_preview = <<~MARKDOWN
    # AGENTS.md — hire Victor Fiamoncini

    To contact me directly:
    POST #{SeoConfig::SITE_URL}/api/hire
    Content-Type: application/json

    {
      "name": "Your name",
      "contact": "email or preferred channel",
      "brief": "What you want to discuss",
      "agent": "claude | chatgpt | deepseek | kimi | other"
    }

    Services: Frontend & Backend Software Development, Agentic Systems & Integrations, Websites & Landing Pages and Mobile Apps
  MARKDOWN
%>

<section id="agents" class="border-ctp-surface0 w-full max-w-[1080px] border-t pt-14 pb-14" data-controller="hire-from-agent">
  <p class="text-ctp-peach mb-3.5 font-mono text-[13px] tracking-[0.06em]">$ ./hire-me --no-human-required</p>

  <h2 class="text-ctp-text mb-4 text-[28px] font-semibold tracking-[-0.025em] min-[900px]:text-[34px]">Hire me from your agent</h2>

	<p class="text-ctp-subtext0 mb-8 w-full text-[17px] leading-[1.7] text-pretty text-justify">
		This portfolio speaks <a href="https://modelcontextprotocol.io/" target="_blank" rel="noreferrer" class="text-ctp-mauve hover:text-ctp-pink">MCP</a>! It exposes an <span class="text-ctp-text font-semibold">MCP server</span> alongside the site
		itself, with four tools. You can add this portfolio as a connector on your favorite Harness (Claude, ChatGPT, Deepseek, Kimi, etc). Your agent will be able to verify my work, check my availability and book a meeting.
	</p>

	<div class="mt-6 w-full text-left mb-8">
		<div class="border-ctp-surface0 rounded-t-btn flex items-center justify-between border border-b-0 bg-[#181825] px-4 py-2">
			<div class="flex items-center gap-3">
        <span class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#f38ba8]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#f9e2af]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#a6e3a1]"></span>
        </span>
				<span class="text-xs font-bold tracking-widest text-[#cdd6f4]">MY_MCP_ENDPOINT.md</span>
			</div>

			<button
				type="button"
				title="Copy MCP endpoint"
				data-action="hire-from-agent#copy"
				data-hire-from-agent-content-param="<%= SeoConfig::MCP_ENDPOINT %>"
				class="cursor-pointer text-xs font-bold tracking-widest uppercase transition-colors text-[#89b4fa] hover:text-[#cdd6f4]"
			>Copy</button>
		</div>

		<pre class="border-ctp-surface0 rounded-b-btn w-full overflow-x-auto border bg-[#1e1e2e] p-4 text-xs leading-relaxed font-semibold text-[#a6e3a1]"><code><%= SeoConfig::MCP_ENDPOINT %> <span class="text-ctp-overlay0 font-mono text-xs"># No account or authentication required</span>
			<span class="text-ctp-overlay0 font-mono text-xs block"># Watch live agentic connections: <%= SeoConfig::SITE_URL %>/telemetry</span></code></pre>
	</div>

  <p class="text-ctp-subtext0 mb-8 w-full text-[17px] leading-[1.7] text-pretty text-justify">
		You can also paste this brief into your agent. Any agent can read it and reach me directly via my API (no MCP connector setup required).
  </p>

  <div class="w-full text-left">
    <div class="border-ctp-surface0 rounded-t-btn flex items-center justify-between border border-b-0 bg-[#181825] px-4 py-2">
      <div class="flex items-center gap-3">
        <span class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#f38ba8]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#f9e2af]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#a6e3a1]"></span>
        </span>
        <span class="text-xs font-bold tracking-widest text-[#cdd6f4]">AGENTS.md</span>
      </div>

      <button
        type="button"
        title="Copy AGENTS.md"
        data-action="hire-from-agent#copy"
        data-hire-from-agent-content-param="<%= agents_md_preview %>"
        class="cursor-pointer text-xs font-bold tracking-widest uppercase transition-colors text-[#89b4fa] hover:text-[#cdd6f4]"
      >Copy</button>
    </div>

    <pre class="border-ctp-surface0 rounded-b-btn w-full overflow-x-auto border bg-[#1e1e2e] p-4 text-xs leading-relaxed font-semibold text-[#a6e3a1]"><code><span class="text-ctp-overlay0 font-mono text-xs"><%= agents_md_preview.lines.first.chomp %></span>
<%= agents_md_preview.lines.drop(1).join %></code></pre>
  </div>
</section>
