<section id="job-match" class="w-full max-w-[1080px] py-14">
  <div class="bg-ctp-mauve text-on-strong border-ink shadow-brut-lg border-4 selection:bg-ink selection:text-ctp-base p-[clamp(20px,4vw,48px)]">
    <%= render "shared/section_heading", prompt: t("pages.job_match.prompt"), heading: t("pages.job_match.heading"), prompt_class: "bg-ctp-base text-ctp-text", heading_class: "text-on-strong", counter: "[03/04]", counter_class: "text-on-strong" %>

    <% rag_link = link_to("RAG", "https://en.wikipedia.org/wiki/Retrieval-augmented_generation", target: "_blank", rel: "noreferrer", title: t("pages.job_match.rag_link_title"), class: "link-brut px-0.5 [--link-color:var(--color-on-strong)] [--link-accent:var(--color-ctp-base)]") %>

    <p class="mb-7 w-full text-lg leading-[1.65] font-medium text-pretty min-[640px]:text-justify">
      <%= t("pages.job_match.intro_html", rag_link: rag_link) %>
    </p>

    <%= form_with url: api_job_match_path, method: :post, class: "grid w-full gap-4",
      data: {
        controller: "job-match", action: "submit->job-match#submit",
        job_match_submitting_value: t("pages.job_match.submitting"),
        job_match_submit_label_value: t("pages.job_match.submit"),
        job_match_generic_error_value: t("pages.job_match.generic_error"),
        job_match_locale_value: I18n.locale,
      } do |form| %>

      <label class="grid gap-2.5">
        <span class="font-mono text-[13px] font-extrabold tracking-[0.08em] uppercase"><%= t("pages.job_match.label") %></span>

        <%= form.text_area :job_description, id: "job_description", rows: 7, required: true,
          maxlength: MatchJobUseCase::MAX_LENGTH, placeholder: t("pages.job_match.placeholder"),
          class: "bg-ctp-base text-ctp-text border-ink field w-full resize-y border-[3px] p-4 text-base leading-relaxed",
          data: { job_match_target: "input" } %>

        <p class="bg-ctp-base text-ctp-red border-ink hidden w-fit border-2 px-2.5 py-1 text-xs font-bold" data-job-match-target="fieldError"></p>
      </label>

      <div class="flex flex-wrap items-center gap-4">
        <%= form.submit t("pages.job_match.submit"),
          data: { job_match_target: "submit" },
          class: "bg-ctp-base text-ctp-text hover:bg-ctp-mantle border-ink shadow-brut press min-h-[54px] cursor-pointer border-[3px] px-7 text-[17px] font-bold disabled:cursor-not-allowed disabled:opacity-60 max-[531px]:w-full" %>

        <p class="bg-ctp-base text-ctp-red border-ink hidden border-2 px-3 py-2 text-sm font-bold" data-job-match-target="banner"></p>
      </div>

      <div class="bg-term-bg border-ink shadow-brut hidden border-[3px] p-6" data-job-match-target="result" aria-live="polite">
        <div class="text-term-text text-base leading-[1.7] whitespace-pre-line" data-job-match-target="summary"></div>
      </div>
    <% end %>
  </div>
</section>
