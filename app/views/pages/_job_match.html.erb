<section id="job-match" class="border-ctp-surface0 w-full max-w-[1080px] border-t pt-14 pb-14">
  <p class="text-ctp-lavender mb-3.5 font-mono text-[13px] tracking-[0.06em]"><%= t("pages.job_match.prompt") %></p>

  <h2 class="text-ctp-text mb-4 text-[28px] font-semibold tracking-[-0.025em] min-[900px]:text-[34px]"><%= t("pages.job_match.heading") %></h2>

  <% rag_link = link_to("RAG", "https://en.wikipedia.org/wiki/Retrieval-augmented_generation", target: "_blank", rel: "noreferrer", title: t("pages.job_match.rag_link_title"), class: "text-ctp-mauve hover:text-ctp-pink transition-colors") %>

	<p class="text-ctp-subtext0 mb-10 w-full text-[17px] leading-[1.7] text-pretty text-justify">
    <%= t("pages.job_match.intro_html", rag_link: rag_link) %>
  </p>

  <%= form_with url: job_match_path, method: :post, class: "grid w-full gap-4",
    data: {
      controller: "job-match", action: "submit->job-match#submit",
      job_match_submitting_value: t("pages.job_match.submitting"),
      job_match_submit_label_value: t("pages.job_match.submit"),
      job_match_generic_error_value: t("pages.job_match.generic_error"),
      job_match_locale_value: I18n.locale,
    } do |form| %>

		<label class="grid gap-2">
      <span class="text-ctp-subtext0 font-mono text-xs"><%= t("pages.job_match.label") %></span>

			<%= form.text_area :job_description, id: "job_description", rows: 8, required: true,
        maxlength: MatchJobUseCase::MAX_LENGTH, placeholder: t("pages.job_match.placeholder"),
        class: "bg-ctp-mantle border-ctp-surface1 text-ctp-text rounded-btn focus:border-ctp-blue w-full resize-y border px-[14px] py-3 text-[15px] transition-colors outline-none",
        data: { job_match_target: "input" } %>

			<p class="text-ctp-red hidden text-xs" data-job-match-target="fieldError"></p>
    </label>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit t("pages.job_match.submit"),
        data: { job_match_target: "submit" },
        class: "bg-ctp-mauve text-ctp-crust rounded-btn hover:bg-ctp-pink cursor-pointer px-[26px] py-[13px] font-semibold transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_0_20px_-4px_var(--color-ctp-pink)] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-y-0 disabled:hover:shadow-none max-[531px]:w-full" %>

      <p class="text-ctp-red hidden text-sm" data-job-match-target="banner"></p>
    </div>

    <div class="border-ctp-surface0 rounded-btn hidden border bg-term-bg p-6" data-job-match-target="result" aria-live="polite">
      <div class="text-ctp-text text-[16px] leading-[1.7] whitespace-pre-line" data-job-match-target="summary"></div>
    </div>
  <% end %>
</section>
