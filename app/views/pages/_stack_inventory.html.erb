<%
  items = stack_inventory(experiences)
  usage_for = ->(item) { item[:companies].any? ? item[:companies].join(", ") : t("pages.stack.not_in_log") }
  first = items.first
%>
<section aria-labelledby="stack-heading" class="flex w-full max-w-[1080px] flex-col gap-5 pt-6 pb-14" data-controller="stack">
  <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-2">
    <h2 id="stack-heading" class="text-ctp-text font-pixel text-[22px] font-medium"><%= t("pages.stack.heading") %></h2>
    <p class="text-ctp-subtext0 font-mono text-[13px]"><%= t("pages.stack.hint", count: items.size) %></p>
  </div>

  <%# Flowing chips on phones (a 2-column grid of 30 is 15 rows), a grid of slots from 640px %>
  <ul class="flex flex-wrap gap-3 p-1 min-[640px]:grid min-[640px]:grid-cols-[repeat(auto-fill,minmax(132px,1fr))]">
    <% items.each do |item| %>
      <li>
        <button
          type="button"
          aria-pressed="<%= item == first %>"
          title="<%= t("pages.stack.item_title", name: item[:name]) %>"
          data-stack-target="item"
          data-action="stack#pick"
          data-name="<%= item[:name] %>"
          data-usage="<%= usage_for.(item) %>"
          class="bg-ctp-mantle text-ctp-text px-frame-sm aria-pressed:bg-ctp-surface0 flex h-11 cursor-pointer items-center gap-2 px-3 text-left transition-colors min-[640px]:h-16 min-[640px]:w-full min-[640px]:flex-col min-[640px]:items-start min-[640px]:justify-between min-[640px]:gap-0 min-[640px]:py-2.5 [--px-line:var(--color-ctp-surface1)] aria-pressed:[--px-line:var(--color-ctp-yellow)]"
        >
          <span aria-hidden="true" class="h-2 w-2 shrink-0 <%= item[:category] ? item[:category][:pip_class] : "bg-ctp-subtext0" %>"></span>
          <span class="truncate font-mono text-[13px] font-bold"><%= item[:name] %></span>
        </button>
      </li>
    <% end %>
  </ul>

  <div class="bg-ctp-crust px-frame-sm m-1 flex flex-wrap items-center gap-x-[18px] gap-y-2.5 px-[18px] py-3.5">
    <p class="flex flex-wrap items-center gap-x-[18px] gap-y-1.5" aria-live="polite">
      <span class="text-ctp-text inline-flex items-center gap-2 font-pixel text-[17px]">
        <span class="text-ctp-yellow block h-[11px] w-1.5"><%= svg_icon(:cursor) %></span>
        <span data-stack-target="name"><%= first[:name] %></span>
      </span>
      <span class="text-ctp-subtext1"><%= t("pages.stack.used_in") %> <strong class="text-ctp-text" data-stack-target="usage"><%= usage_for.(first) %></strong></span>
    </p>

    <ul class="text-ctp-subtext0 ml-auto flex flex-wrap gap-x-3.5 gap-y-1.5 font-mono text-xs" aria-hidden="true">
      <% ExperiencesHelper::TECH_CATEGORIES.each do |category| %>
        <li class="inline-flex items-center gap-1.5"><span class="h-2 w-2 <%= category[:pip_class] %>"></span><%= t(category[:label_key]).downcase %></li>
      <% end %>
    </ul>
  </div>
</section>
