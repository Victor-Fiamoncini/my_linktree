<section id="about" class="grid w-full max-w-[1080px] items-center gap-12 pt-16 pb-14 min-[900px]:grid-cols-[1fr_320px] min-[900px]:gap-16 min-[900px]:pt-24">
  <div>
    <p class="text-ctp-green mb-5 font-mono text-[13px] tracking-[0.06em]">$ whoami</p>

    <h1 class="text-ctp-text mb-6 text-[40px] leading-[1.04] font-bold tracking-[-0.035em] min-[900px]:text-[58px]">
      Victor <span class="text-ctp-mauve">Fiamoncini</span>
    </h1>

    <p class="text-ctp-subtext1 mb-[18px] max-w-[46ch] text-[19px] leading-[1.6] text-pretty">
      Software Engineer since <%= start_year_of_work %>, across company and freelance projects.
    </p>

    <p class="text-ctp-subtext0 mb-[18px] max-w-[52ch] text-[17px] leading-[1.7] text-pretty">
      I build full-stack products mostly using
      <a
        href="https://rubyonrails.org/"
        target="_blank"
        rel="noopener noreferrer"
        title="Ruby on Rails official website"
        class="text-ctp-text hover:text-ctp-red after:bg-ctp-red relative inline-flex items-center gap-1 font-semibold transition-colors after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:transition-all after:duration-300 hover:after:w-full"
      >
        <span class="text-ctp-red h-[13px] w-[13px]"><%= svg_icon(:gem) %></span>Ruby on Rails
      </a>
      and
      <a
        href="https://nextjs.org/"
        target="_blank"
        rel="noopener noreferrer"
        title="Next.js official website"
        class="text-ctp-text hover:text-ctp-blue after:bg-ctp-blue relative inline-flex items-center gap-1 font-semibold transition-colors after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:transition-all after:duration-300 hover:after:w-full"
      >
        <span class="h-[13px] w-[13px]"><%= svg_icon(:nextjs) %></span>Next.js
      </a>, from relational schema design and background
      jobs to server components and everything in between, with end-to-end ownership all the way to
      production.
    </p>

    <blockquote class="border-ctp-mauve text-ctp-text mb-[18px] max-w-[52ch] border-l-2 pl-4 text-[17px] leading-[1.7] italic">
      "Fixed-scope engagements, senior execution, no hand-holding."
    </blockquote>

    <p class="text-ctp-subtext0 mb-9 max-w-[52ch] text-[17px] leading-[1.7] text-pretty">
      Lately that includes shipping things AI agents can talk to directly, like the MCP server running this very
      page.
    </p>

    <div class="flex flex-wrap gap-3">
      <%= render "shared/get_in_touch_button" %>
      <%= render "shared/external_link", icon: :github, link: SeoConfig::GITHUB_URL, label: "GitHub", variant: "outline", accent: "blue" %>
      <%= render "shared/external_link", icon: :linkedin, link: SeoConfig::LINKEDIN_URL, label: "LinkedIn", variant: "outline", accent: "blue" %>
    </div>
  </div>

  <div class="relative order-first justify-self-center min-[900px]:order-none min-[900px]:justify-self-end">
    <div class="absolute -inset-2.5 rounded-[10px] bg-[linear-gradient(150deg,var(--color-ctp-blue),var(--color-ctp-mauve)_55%,var(--color-ctp-green))] opacity-50"></div>

    <a
      href="<%= SeoConfig::LINKEDIN_URL %>"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Victor Fiamoncini on LinkedIn"
      title="Victor Fiamoncini on LinkedIn"
      class="group rounded-card relative block"
      data-controller="photo-pixelate"
    >
      <img
        data-photo-pixelate-target="source"
        src="/photo.jpg"
        alt="Victor Fiamoncini"
        width="300"
        height="350"
        class="border-ctp-surface1 rounded-card relative block h-[350px] w-[300px] border object-cover transition-opacity duration-500 group-hover:opacity-0"
      >

      <canvas
        data-photo-pixelate-target="canvas"
        width="300"
        height="350"
        aria-hidden="true"
        class="border-ctp-surface1 rounded-card pointer-events-none absolute inset-0 block h-[350px] w-[300px] border opacity-0 transition-opacity duration-500 [image-rendering:pixelated] group-hover:opacity-100"
      ></canvas>
    </a>
  </div>
</section>
