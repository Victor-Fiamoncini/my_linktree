<%
  tag_name ||= :h2
  counter ||= nil
  heading_class ||= "text-ctp-text"
  counter_class ||= "text-ctp-subtext0"
%>
<div class="mb-8 flex flex-col items-start gap-3.5">
  <div class="flex w-full items-center justify-between gap-4">
    <p class="<%= prompt_class %> px-raised-sm m-0.5 inline-block min-w-0 px-2.5 py-1 font-mono text-sm font-bold [overflow-wrap:anywhere]"><%= prompt %></p>

    <% if counter %><span class="<%= counter_class %> shrink-0 font-pixel text-[15px]"><%= counter %></span><% end %>
  </div>

  <%= content_tag tag_name, heading, class: "#{heading_class} font-pixel text-[clamp(32px,4.4vw,46px)] leading-[1.05] font-semibold" %>
</div>
