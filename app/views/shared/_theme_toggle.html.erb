<button
  type="button"
  data-action="theme#toggle"
  data-theme-target="toggle"
  aria-pressed="<%= current_theme == "latte" %>"
  aria-label="<%= t("shared.header.toggle_theme") %>"
  title="<%= t("shared.header.theme_title.#{current_theme}") %>"
  class="bg-theme-accent text-on-accent border-ink shadow-brut-sm press focus-visible:outline-ink flex h-11 w-11 cursor-pointer items-center justify-center border-[3px] focus-visible:outline-2 focus-visible:outline-offset-4"
>
  <span class="h-5 w-5 latte:hidden"><%= svg_icon(:sun) %></span>

  <span class="hidden h-5 w-5 latte:block"><%= svg_icon(:moon) %></span>
</button>
