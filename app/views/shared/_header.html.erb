<%
  section_links = [
    { label: t("shared.header.nav_about_label"), href: "#{root_path}#about", accent: "blue", title: t("shared.header.nav_about_title") },
    { label: t("shared.header.nav_experience_label"), href: "#{root_path}#experience", accent: "mauve", title: t("shared.header.nav_experience_title") },
    { label: t("shared.header.nav_hire_label"), href: "#{root_path}#agents", accent: "peach", title: t("shared.header.nav_hire_title") },
    { label: t("shared.header.nav_job_match_label"), href: "#{root_path}#job-match", accent: "lavender", title: t("shared.header.nav_job_match_title") },
    { label: t("shared.header.nav_contact_label"), href: "#{root_path}#contact", accent: "pink", title: t("shared.header.nav_contact_title") },
  ]
  other_locale = I18n.locale == :en ? "pt-BR" : "en"
  other_language_name = t("shared.header.other_language_name")
  switch_label = I18n.locale == :en ? "PT-BR" : "EN"
  switch_path = (content_for(:canonical) || request.path).sub(%r{\A/(en|pt-BR)}, "/#{other_locale}")
  nav_link_classes = {
    "blue" => "text-ctp-text hover:text-ctp-blue relative pb-1 font-semibold transition-colors after:absolute after:bottom-0 after:left-0 after:h-[3px] after:w-0 after:bg-ctp-blue after:transition-all after:duration-300 hover:after:w-full",
    "mauve" => "text-ctp-text hover:text-ctp-mauve relative pb-1 font-semibold transition-colors after:absolute after:bottom-0 after:left-0 after:h-[3px] after:w-0 after:bg-ctp-mauve after:transition-all after:duration-300 hover:after:w-full",
    "peach" => "text-ctp-text hover:text-ctp-peach relative pb-1 font-semibold transition-colors after:absolute after:bottom-0 after:left-0 after:h-[3px] after:w-0 after:bg-ctp-peach after:transition-all after:duration-300 hover:after:w-full",
    "lavender" => "text-ctp-text hover:text-ctp-lavender relative pb-1 font-semibold transition-colors after:absolute after:bottom-0 after:left-0 after:h-[3px] after:w-0 after:bg-ctp-lavender after:transition-all after:duration-300 hover:after:w-full",
    "pink" => "text-ctp-text hover:text-ctp-pink relative pb-1 font-semibold transition-colors after:absolute after:bottom-0 after:left-0 after:h-[3px] after:w-0 after:bg-ctp-pink after:transition-all after:duration-300 hover:after:w-full",
  }
  telemetry_button_class = "bg-ctp-green text-on-accent hover:text-on-accent border-ink shadow-brut-sm press inline-flex min-h-11 items-center gap-1 border-[3px] px-3.5 font-extrabold"
  switch_class = "text-ctp-text hover:text-ctp-mauve inline-flex min-h-11 items-center font-mono text-sm font-extrabold transition-colors"
%>

<header
  data-controller="mobile-nav"
  class="border-ink bg-ctp-mantle sticky top-0 z-20 w-full border-b-4"
>
  <nav class="mx-auto flex max-w-[1080px] items-center justify-between gap-4 px-6 py-3.5 min-[900px]:px-8">
    <%= link_to root_path, title: t("shared.header.home_title"), class: "flex items-center gap-3" do %>
      <span aria-hidden="true" class="bg-ctp-mauve text-on-strong border-ink shadow-brut-sm flex h-11 w-11 items-center justify-center border-[3px] font-mono text-base font-extrabold">VF</span>

      <span class="text-ctp-text max-[424px]:hidden text-lg font-bold tracking-[-0.02em] whitespace-nowrap">Victor Fiamoncini</span>
    <% end %>

    <ul class="hidden items-center gap-x-5 font-mono text-sm whitespace-nowrap min-[900px]:flex min-[1000px]:gap-x-6">
      <% section_links.each do |link| %>
        <li><%= link_to link[:label], link[:href], title: link[:title], class: nav_link_classes.fetch(link[:accent]) %></li>
      <% end %>

			<li><%= link_to telemetry_path, title: t("shared.header.telemetry_title"), class: telemetry_button_class do %><%= t("shared.header.telemetry_button_label") %> <span aria-hidden="true">↗</span><% end %></li>

			<li><%= link_to switch_label, switch_path, title: t("shared.header.switch_language", language: other_language_name), rel: "alternate", hreflang: other_locale, class: switch_class %></li>

      <li><%= render "shared/theme_toggle" %></li>
    </ul>

    <div class="flex items-center gap-3 min-[900px]:hidden">
      <%= link_to switch_label, switch_path, title: t("shared.header.switch_language", language: other_language_name), rel: "alternate", hreflang: other_locale, class: switch_class %>

      <%= render "shared/theme_toggle" %>

      <button
        type="button"
        data-action="mobile-nav#toggle"
        data-mobile-nav-target="toggleButton"
        aria-expanded="false"
        aria-label="<%= t("shared.header.toggle_nav") %>"
        title="<%= t("shared.header.toggle_nav") %>"
        class="bg-ctp-mantle text-ctp-text border-ink shadow-brut-sm press flex h-11 w-11 cursor-pointer items-center justify-center border-[3px]"
      >
        <span data-mobile-nav-target="openIcon" class="h-4 w-4"><%= svg_icon(:bars) %></span>

        <span data-mobile-nav-target="closeIcon" class="hidden h-4 w-4"><%= svg_icon(:times) %></span>
      </button>
    </div>
  </nav>

  <div data-mobile-nav-target="menu" class="border-ink bg-ctp-mantle hidden border-t-4 px-6 py-5 min-[900px]:hidden">
    <ul class="flex flex-col items-start gap-4 font-mono text-sm">
      <% section_links.each do |link| %>
        <li><%= link_to link[:label], link[:href], title: link[:title], class: nav_link_classes.fetch(link[:accent]), data: { action: "mobile-nav#close" } %></li>
      <% end %>

			<li><%= link_to telemetry_path, title: t("shared.header.telemetry_title"), class: telemetry_button_class, data: { action: "mobile-nav#close" } do %><%= t("shared.header.telemetry_button_label") %> <span aria-hidden="true">↗</span><% end %></li>
    </ul>
  </div>
</header>
