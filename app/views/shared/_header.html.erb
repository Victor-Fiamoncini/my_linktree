<%
  section_links = [
    { label: t("shared.header.nav_about_label"), href: "#{root_path}#about", title: t("shared.header.nav_about_title") },
    { label: t("shared.header.nav_experience_label"), href: "#{root_path}#experience", title: t("shared.header.nav_experience_title") },
    { label: t("shared.header.nav_hire_label"), href: "#{root_path}#agents", title: t("shared.header.nav_hire_title") },
    { label: t("shared.header.nav_job_match_label"), href: "#{root_path}#job-match", title: t("shared.header.nav_job_match_title") },
    { label: t("shared.header.nav_contact_label"), href: "#{root_path}#contact", title: t("shared.header.nav_contact_title") },
  ]
  other_locale = I18n.locale == :en ? "pt-BR" : "en"
  other_language_name = t("shared.header.other_language_name")
  switch_label = I18n.locale == :en ? "PT-BR" : "EN"
  switch_path = (content_for(:canonical) || request.path).sub(%r{\A/(en|pt-BR)}, "/#{other_locale}")
  xp_years = GetXpYearsUseCase.new.execute
  xp_segments = [ 10, xp_years ].max
  # The ▸ cursor shows on hover and keyboard focus, the way a menu marks the item it's on
  nav_link_class = "group text-ctp-subtext1 hover:text-ctp-text focus-visible:text-ctp-text inline-flex min-h-11 items-center gap-1.5 font-pixel text-base transition-colors"
  nav_cursor_class = "block h-[11px] w-1.5 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100"
  telemetry_button_class = "bg-ctp-green text-on-accent hover:text-on-accent px-raised-sm press inline-flex min-h-10 items-center gap-1 px-3.5 font-pixel text-base"
  switch_class = "text-ctp-text hover:text-ctp-mauve inline-flex min-h-11 items-center font-mono text-sm font-bold transition-colors"
%>

<header
  data-controller="mobile-nav"
  class="bg-ctp-mantle sticky top-0 z-20 w-full shadow-[0_4px_0_0_var(--color-line)]"
>
  <nav class="mx-auto flex max-w-[1080px] items-center justify-between gap-4 px-5 py-3.5 min-[640px]:px-8">
    <%= link_to root_path, title: t("shared.header.home_title"), class: "text-ctp-text hover:text-ctp-text flex items-center gap-3.5" do %>
      <span aria-hidden="true" class="bg-ctp-mauve text-on-strong px-raised-sm flex h-11 w-11 shrink-0 items-center justify-center font-pixel text-lg font-bold">VF</span>

      <span class="flex flex-col gap-1 max-[424px]:hidden">
        <span class="font-pixel text-lg leading-none whitespace-nowrap">Victor Fiamoncini</span>

        <span class="flex items-center gap-1.5" title="<%= t("shared.header.xp_title", count: xp_years) %>">
          <span class="text-ctp-subtext0 font-pixel text-[11px] leading-none"><%= t("shared.header.xp_label") %></span>
          <span class="bg-ctp-crust flex gap-0.5 p-0.5" aria-hidden="true">
            <% xp_segments.times do |index| %>
              <span class="h-1.5 w-[7px] <%= index < xp_years ? "bg-ctp-green" : "bg-ctp-surface0" %>"></span>
            <% end %>
          </span>
          <span class="sr-only"><%= t("shared.header.xp_title", count: xp_years) %></span>
        </span>
      </span>
    <% end %>

    <ul class="hidden items-center gap-x-5 whitespace-nowrap min-[900px]:flex min-[1000px]:gap-x-6">
      <% section_links.each do |link| %>
        <li>
          <%= link_to link[:href], title: link[:title], class: nav_link_class do %>
            <span class="<%= nav_cursor_class %>"><%= svg_icon(:cursor) %></span><%= link[:label] %>
          <% end %>
        </li>
      <% end %>

			<li><%= link_to telemetry_path, title: t("shared.header.telemetry_title"), class: telemetry_button_class do %><%= t("shared.header.telemetry_button_label") %> <span aria-hidden="true">↗</span><% end %></li>

			<li><%= link_to switch_label, switch_path, title: t("shared.header.switch_language", language: other_language_name), rel: "alternate", hreflang: other_locale, class: switch_class %></li>

      <li><%= render "shared/theme_toggle" %></li>
    </ul>

    <div class="flex items-center gap-3 min-[900px]:hidden">
      <%= link_to switch_label, switch_path, title: t("shared.header.switch_language", language: other_language_name), rel: "alternate", hreflang: other_locale, class: switch_class %>

      <%= render "shared/theme_toggle" %>

      <button
        type="button"
        data-action="mobile-nav#toggle"
        data-mobile-nav-target="toggleButton"
        aria-expanded="false"
        aria-label="<%= t("shared.header.toggle_nav") %>"
        title="<%= t("shared.header.toggle_nav") %>"
        class="bg-ctp-crust text-ctp-text px-frame-sm press flex h-11 w-11 cursor-pointer items-center justify-center"
      >
        <span data-mobile-nav-target="openIcon" class="block h-3.5 w-3.5"><%= svg_icon(:bars) %></span>

        <span data-mobile-nav-target="closeIcon" class="hidden h-3.5 w-3.5"><%= svg_icon(:times) %></span>
      </button>
    </div>
  </nav>

  <div data-mobile-nav-target="menu" class="bg-ctp-mantle hidden px-5 pt-5 pb-6 shadow-[inset_0_4px_0_0_var(--color-line)] min-[640px]:px-8 min-[900px]:hidden">
    <ul class="flex flex-col items-start gap-2">
      <% section_links.each do |link| %>
        <li>
          <%= link_to link[:href], title: link[:title], class: nav_link_class, data: { action: "mobile-nav#close" } do %>
            <span class="<%= nav_cursor_class %>"><%= svg_icon(:cursor) %></span><%= link[:label] %>
          <% end %>
        </li>
      <% end %>

			<li class="mt-2 p-1"><%= link_to telemetry_path, title: t("shared.header.telemetry_title"), class: telemetry_button_class, data: { action: "mobile-nav#close" } do %><%= t("shared.header.telemetry_button_label") %> <span aria-hidden="true">↗</span><% end %></li>
    </ul>
  </div>
</header>
