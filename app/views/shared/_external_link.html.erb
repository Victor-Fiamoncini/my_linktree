<%
  variant ||= "outline"
  accent ||= "blue"
  handle ||= nil
  title ||= t("shared.external_link.title", name: label)
  icon_class = { "blue" => "text-ctp-blue", "mauve" => "text-ctp-mauve", "teal" => "text-ctp-teal" }.fetch(accent)
%>
<% if variant == "card" %>
  <a href="<%= link %>" target="_blank" rel="noopener noreferrer" title="<%= title %>" class="bg-ctp-mantle text-ctp-text hover:text-ctp-text px-panel press m-1 flex min-h-16 items-center justify-between gap-3 px-4 py-3 min-[640px]:px-5">
    <span class="flex min-w-0 flex-col gap-1">
      <% if label %><span class="font-pixel text-lg leading-none"><%= label %></span><% end %>
      <% if handle %><span class="text-ctp-subtext0 truncate font-mono text-[13px]"><%= handle %></span><% end %>
    </span>
    <span class="<%= icon_class %> flex shrink-0 items-center gap-2">
      <span class="block h-[18px] w-[18px]"><%= svg_icon(icon) %></span>
      <span aria-hidden="true" class="text-xl">↗</span>
    </span>
  </a>
<% else %>
  <a href="<%= link %>" target="_blank" rel="noopener noreferrer" title="<%= title %>" class="bg-ctp-mantle text-ctp-text hover:text-ctp-text px-frame press inline-flex min-h-[52px] items-center justify-center gap-[9px] px-5 max-[531px]:w-full">
    <span class="<%= icon_class %> block h-[18px] w-[18px]"><%= svg_icon(icon) %></span>
    <% if label %><span class="font-pixel text-lg"><%= label %> ↗</span><% end %>
  </a>
<% end %>
