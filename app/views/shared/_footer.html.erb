<footer class="bg-ctp-mantle text-ctp-subtext0 w-full shadow-[0_-4px_0_0_var(--color-line)]">
  <div class="mx-auto flex max-w-[1080px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-6 font-mono text-[13px] min-[640px]:px-8 max-[424px]:flex-col max-[424px]:justify-center max-[424px]:text-center">
    <span><%= t("shared.footer.copyright", year: Date.current.year) %></span>
    <span>
      <%= t("shared.footer.built_with") %>
      <a href="https://catppuccin.com/" target="_blank" rel="noreferrer" title="Catppuccin official website" class="link-px [--link-accent:var(--color-ctp-mauve)]">catppuccin</a>
    </span>
    <a href="#top" class="text-ctp-text hover:text-ctp-mauve inline-flex min-h-11 items-center gap-2 font-pixel text-sm">
      <%= t("shared.footer.back_to_top") %>
      <span aria-hidden="true" class="block h-1.5 w-[11px] rotate-180"><%= svg_icon(:caret_down) %></span>
    </a>
  </div>
</footer>
