<%
  json_ld = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "#{SeoConfig::SITE_URL}/#person",
        name: SeoConfig::AUTHOR_NAME,
        url: SeoConfig::SITE_URL,
        image: "#{SeoConfig::SITE_URL}/photo.jpg",
        jobTitle: SeoConfig::JOB_TITLE,
        sameAs: [ SeoConfig::LINKEDIN_URL, SeoConfig::GITHUB_URL ],
      },
      {
        "@type": "WebSite",
        "@id": "#{SeoConfig::SITE_URL}/#website",
        name: SeoConfig::SITE_NAME,
        url: SeoConfig::SITE_URL,
        author: { "@id": "#{SeoConfig::SITE_URL}/#person" },
      },
    ],
  }
%>
<script type="application/ld+json"><%= raw json_ld.to_json %></script>
